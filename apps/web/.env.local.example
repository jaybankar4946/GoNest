NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Only list providers after credentials and redirect URLs are configured in Supabase Auth.
# Google is displayed by the app by default. Optional providers: apple,facebook.
# Example after setup: NEXT_PUBLIC_AUTH_PROVIDERS=apple
NEXT_PUBLIC_AUTH_PROVIDERS=

# India-first additional sign-in: enable only after configuring an SMS provider,
# OTP templates, rate limits, abuse monitoring and production billing limits in Supabase.
NEXT_PUBLIC_AUTH_PHONE=false

# Server-only secret required by the account-deletion endpoint (never expose with NEXT_PUBLIC_).
# Configure in Vercel Production/Preview environments separately after endpoint review.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVER-ONLY-SERVICE-ROLE-KEY
