NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Optional sign-in methods. Turn on ONLY after enabling the provider in Supabase (Authentication > Sign In / Providers).
# Comma-separated list: google,apple,facebook
NEXT_PUBLIC_AUTH_PROVIDERS=
# Phone OTP needs an SMS provider configured in Supabase (e.g. Twilio). Set to true when ready.
NEXT_PUBLIC_AUTH_PHONE=false
